{
  "name": "@siyuqian/dsh-computer-use",
  "version": "0.1.0-dev.0",
  "description": "Target-bound, evidence-backed macOS Computer Use for DeepSeek Harness. Development foundation; native control is not exposed.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts/index.d.ts",
      "default": "./lib/contracts/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiyuQian/dsh-computer-use.git"
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.2-rc.1"
  },
  "packageManager": "pnpm@11.28.5",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:profile": "vitest run tests/profile",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "build:fixture": "node scripts/build-fixture.mjs",
    "test:fixture": "vitest run tests/fixture",
    "build:helper": "node scripts/build-helper.mjs",
    "build:stop": "node scripts/build-stop.mjs",
    "build:controller": "node scripts/build-controller.mjs",
    "test:transport": "vitest run tests/transport",
    "test:native-observation": "node scripts/test-native-observation.mjs",
    "test:native-action": "node scripts/test-native-action.mjs",
    "test:native-e2e": "node scripts/test-native-e2e.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
    "@rolldown/binding-wasm32-wasi": "1.2.16",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
